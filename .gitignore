# Entorno virtual y cachés de Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Salidas de sesiones y audios de prueba (pueden pesar mucho; se regeneran)
sesiones/*
!sesiones/.gitkeep
audio_prueba/*
!audio_prueba/.gitkeep

# Material de las clases (apuntes del profe). Se queda en tu maquina:
# no va al repositorio porque es contenido de un tercero.
material/*
!material/LEEME.md

# Frases de referencia (grabaciones propias)
frases/*
!frases/.gitkeep

# Pistas separadas con Demucs (pesan mucho, se regeneran)
separado/
.venv-demucs/

# La clave del coach (LLM). Es tuya y se queda en tu maquina.
.env
